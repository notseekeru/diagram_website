        "react-dom": "19.3.0",
        "react-icons": "5.7.0",
        "react-zoom-pan-pinch": "4.2.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.13",
        "@tailwindcss/postcss": "4.3.3",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "26.5.1",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.1",
        "autoprefixer": "10.6.0",
        "jsdom": "^30.0.1",
        "postcss": "8.5.28",
        "typescript": "7.0.2",
