{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "group:monorepos",
    "group:recommended",
    "schedule:weekly"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "description": "Renovate proposes no update for unbounded >= floors, so the lock otherwise moves only when a human edits pyproject.toml."
  },
  "labels": ["dependencies", "renovate"],
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "matchCategories": [
        "docker"
      ],
      "pinDigests": true,
      "major": {
        "enabled": true
      }
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions dependencies",
      "separateMajorMinor": false,
      "description": "Bump all action refs (checkout@v6 etc.) in one PR."
    },
    {
      "matchManagers": ["npm"],
      "groupName": "frontend npm dependencies"
    },
    {
      "matchManagers": ["uv", "pep621"],
      "groupName": "backend python dependencies"
    },
    {
      "matchManagers": ["dockerfile"],
      "groupName": "Docker base images",
      "separateMajorMinor": true,
      "description": "Pin + refresh base image digests to resolve base-OS CVEs."
    }
  ]
}
